FELT_VOICE_WHISPER_MODEL=base.en
FELT_VOICE_WHISPER_DEVICE=cpu
FELT_VOICE_WHISPER_COMPUTE_TYPE=int8

# TTS engine: indextts (IndexTTS-2.5 via the felt-indextts service, with a
# per-line mood; see indextts_service/), chatterbox (Chatterbox-Turbo cloning
# a Teto reference clip) or piper. Piper is also the automatic fallback if the
# engine fails to load or errors on a request. Every engine's output goes
# through RVC below.
FELT_VOICE_TTS_ENGINE=chatterbox
FELT_VOICE_INDEXTTS_URL=http://127.0.0.1:8431
FELT_VOICE_INDEXTTS_TIMEOUT_S=60
FELT_VOICE_CHATTERBOX_REF_WAV=./models/chatterbox/teto_ref.wav
FELT_VOICE_CHATTERBOX_DEVICE=cuda
FELT_VOICE_CHATTERBOX_LOW_VRAM=true
# Keep curatable [sigh]/[gasp]/... tags (offline batch only; live = false).
# [laugh]/[chuckle] are always stripped.
FELT_VOICE_ALLOW_TAGS=false

FELT_VOICE_PIPER_VOICE=en_US-lessac-medium
FELT_VOICE_PIPER_VOICES_DIR=./voices

# Optional Kasane Teto voice conversion (RVC) — unset either var to
# disable and get plain Piper output. See assistant-voice.md.
# FELT_VOICE_RVC_MODEL_PATH=./models/rvc-teto/model.pth
# FELT_VOICE_RVC_INDEX_PATH=./models/rvc-teto/model.index
# FELT_VOICE_RVC_INDEX_INFLUENCE=0.66
# Semitones; -4 with the indextts engine (Mario's pick, 2026-09-29).
# FELT_VOICE_RVC_PITCH=0
# false = RVC on the GPU (~1 s per line vs ~3-4 s on CPU); fits next to
# Chatterbox + a 3B chat model on a 6 GB card.
# FELT_VOICE_RVC_ONLY_CPU=false

FELT_VOICE_HOST=0.0.0.0
FELT_VOICE_PORT=8421
# Load HF models from the local cache only (no Hub check on startup)
FELT_VOICE_HF_OFFLINE=true
