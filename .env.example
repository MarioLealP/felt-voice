FELT_VOICE_WHISPER_MODEL=base.en
FELT_VOICE_WHISPER_DEVICE=cpu
FELT_VOICE_WHISPER_COMPUTE_TYPE=int8

FELT_VOICE_PIPER_VOICE=en_US-lessac-medium
FELT_VOICE_PIPER_VOICES_DIR=./voices

# Optional Kasane Teto voice conversion (RVC) — unset either var to
# disable and get plain Piper output. See assistant-voice.md.
# FELT_VOICE_RVC_MODEL_PATH=./models/rvc-teto/model.pth
# FELT_VOICE_RVC_INDEX_PATH=./models/rvc-teto/model.index
# FELT_VOICE_RVC_INDEX_INFLUENCE=0.66
# FELT_VOICE_RVC_ONLY_CPU=true

FELT_VOICE_HOST=0.0.0.0
FELT_VOICE_PORT=8421
